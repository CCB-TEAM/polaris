<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Polaris.Tests</RootNamespace>
    <AssemblyName>Polaris.Tests</AssemblyName>
    <RoslynDir>$(MSBuildToolsPath)\Roslyn\bincore</RoslynDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- 沙箱里 ProjectReference 的 restore 图遍历会触发 MSB4276（嵌套 MSBuild 解析 SDK 失败），
         所以测试用 DLL 引用；run.ps1 保证先建这些项目。 -->
    <Reference Include="Polaris.Assets">
      <HintPath>..\..\src\Polaris.Assets\bin\Debug\net10.0\Polaris.Assets.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Polaris.SdkGen">
      <HintPath>..\..\src\Polaris.SdkGen\bin\Debug\net10.0\Polaris.SdkGen.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Polaris.Pak">
      <HintPath>..\..\src\Polaris.Pak\bin\Debug\net10.0\Polaris.Pak.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Polaris.Compiler">
      <HintPath>..\..\src\Polaris.Compiler\bin\Debug\net10.0\Polaris.Compiler.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Polaris.Sdk">
      <HintPath>..\..\src\Polaris.Sdk\bin\Debug\net10.0\Polaris.Sdk.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(RoslynDir)\Microsoft.CodeAnalysis.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(RoslynDir)\Microsoft.CodeAnalysis.CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="UAssetAPI" Version="1.1.0" />
  </ItemGroup>

  <!-- DLL 引用在增量构建里偶尔不会重拷（编译器改了、测试还是旧 DLL）。
       构建完强制同步一次，避免「测试跑的是上个版本的编译器」。 -->
  <Target Name="SyncProjectDlls" AfterTargets="Build">
    <Copy SourceFiles="..\..\src\Polaris.Assets\bin\Debug\net10.0\Polaris.Assets.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="..\..\src\Polaris.SdkGen\bin\Debug\net10.0\Polaris.SdkGen.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="..\..\src\Polaris.Pak\bin\Debug\net10.0\Polaris.Pak.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="..\..\src\Polaris.Compiler\bin\Debug\net10.0\Polaris.Compiler.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="..\..\src\Polaris.Sdk\bin\Debug\net10.0\Polaris.Sdk.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="false" />
  </Target>
</Project>
